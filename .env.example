# ── Booking provider ────────────────────────────────────────────────
# mock   = clickable demo, nothing is saved (default, no cost)
# hosted = hand off to Square / Booksy / Fresha / Setmore
NEXT_PUBLIC_BOOKING_PROVIDER=mock

# Only needed when NEXT_PUBLIC_BOOKING_PROVIDER=hosted.
# Paste the shop's public booking URL here.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_BOOKING_LABEL=Square
