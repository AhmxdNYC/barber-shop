# ── Booking provider ────────────────────────────────────────────────
# mock   = clickable demo, nothing is saved (default, no cost)
# hosted = hand off to the shop's existing booking page
NEXT_PUBLIC_BOOKING_PROVIDER=mock

# The shop already takes bookings on Fresha. Setting the provider to
# "hosted" with the URL below makes the booking page real immediately,
# at no cost — see docs/BOOKING-PROVIDERS.md.
NEXT_PUBLIC_BOOKING_URL=https://www.fresha.com/lvp/eduardo-barber-shop-park-hill-avenue-yonkers-wr8LbX
NEXT_PUBLIC_BOOKING_LABEL=Fresha
