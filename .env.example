# ── Booking provider ────────────────────────────────────────────────
# mock   = clickable demo, nothing is saved (default, no cost)
# hosted = hand off to the shop's existing booking page
NEXT_PUBLIC_BOOKING_PROVIDER=mock

# The shop already takes bookings on Fresha. Setting the provider to
# "hosted" with the URL below makes the booking page real immediately,
# at no cost — see docs/BOOKING-PROVIDERS.md.
NEXT_PUBLIC_BOOKING_URL=https://www.fresha.com/lvp/eduardo-barber-shop-park-hill-avenue-yonkers-wr8LbX
NEXT_PUBLIC_BOOKING_LABEL=Fresha

# ── Self-hosting (Vultr / any VPS) ──────────────────────────────────
# Only needed when running via docker compose. See docs/DEPLOY-VULTR.md.
SITE_DOMAIN=eduardobarbershop.com
NEXT_PUBLIC_SITE_URL=https://eduardobarbershop.com

POSTGRES_USER=barbershop
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DB=barbershop

# Used to sign sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Email ───────────────────────────────────────────────────────────
# Unset, messages are written to the server log instead of being sent,
# so the whole notification path works with no account anywhere.
RESEND_API_KEY=
EMAIL_FROM="Eduardo Barbershop <hello@eduardobarbershop.com>"

# ── Scheduled job ───────────────────────────────────────────────────
# Protects /api/cron/daily. Unset, the endpoint refuses every request.
CRON_SECRET=
