// Eduardo Barbershop — booking schema.
//
// Multi-barber: every chair keeps its own calendar, working hours and time
// off, and clients choose who cuts them. See PLAN.md for the reasoning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  BARBER
  OWNER
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  ONLINE
  WALK_IN
  PHONE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  REMINDER_24H
  CANCELLED
  RESCHEDULED
  WAITLIST_OPENING
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  CONVERTED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments Appointment[]
  profile      ClientProfile?
  barber       Barber?
  accounts     Account[]
  sessions     Session[]
  waitlist     WaitlistEntry[]
}

/// Barber-facing notes, kept off User so client-visible queries cannot
/// accidentally select them.
model ClientProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes           String?
  visitCount      Int       @default(0)
  noShowCount     Int       @default(0)
  totalSpentCents Int       @default(0)
  lastVisitAt     DateTime?
  isBlocked       Boolean   @default(false)
}

/// A chair. Each one owns its schedule independently.
model Barber {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  nickname        String?
  specialty       String
  bio             String
  yearsExperience Int     @default(0)
  photoUrl        String?
  instagramUrl    String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  /// Set once this barber can sign in and manage their own calendar.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  appointments    Appointment[]
  workingHours    WorkingHours[]
  dateOverrides   DateOverride[]
  recurringBlocks RecurringBlock[]
  timeOff         TimeOff[]
  services        BarberService[]
  waitlist        WaitlistEntry[]
}

/// Singleton (id = 1). Shop policy as data, so rules change without a deploy.
model ShopSettings {
  id                      Int     @id @default(1)
  name                    String
  phone                   String
  email                   String?
  addressLine1            String
  city                    String
  state                   String
  postalCode              String
  timezone                String  @default("America/New_York")
  slotIntervalMinutes     Int     @default(15)
  bufferMinutes           Int     @default(10)
  minLeadTimeMinutes      Int     @default(120)
  maxAdvanceDays          Int     @default(60)
  cancellationWindowHours Int     @default(24)
  holdMinutes             Int     @default(10)
  depositCents            Int     @default(1000)
  instagramUrl            String?
  mapUrl                  String?
}

model Service {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  depositCents    Int
  imageUrl        String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  appointments Appointment[]
  barbers      BarberService[]
  waitlist     WaitlistEntry[]
}

/// Which barbers offer which services, with optional per-barber overrides.
/// No rows for a barber means they offer everything.
model BarberService {
  barberId  String
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  priceCentsOverride      Int?
  durationMinutesOverride Int?

  @@id([barberId, serviceId])
}

/// Weekly template, one row per barber per weekday.
model WorkingHours {
  id              String  @id @default(cuid())
  barberId        String
  barber          Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0 = Sunday
  opensAtMinutes  Int // minutes from midnight, shop-local
  closesAtMinutes Int
  isClosed        Boolean @default(false)

  @@unique([barberId, dayOfWeek])
}

/// Per-date exception: holidays, early closes.
model DateOverride {
  id              String   @id @default(cuid())
  barberId        String
  barber          Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  opensAtMinutes  Int?
  closesAtMinutes Int?
  isClosed        Boolean  @default(false)
  reason          String?

  @@unique([barberId, date])
}

/// Repeating intra-day block, e.g. lunch every weekday.
model RecurringBlock {
  id             String  @id @default(cuid())
  barberId       String
  barber         Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startAtMinutes Int
  endAtMinutes   Int
  label          String
  isActive       Boolean @default(true)

  @@index([barberId, dayOfWeek])
}

/// One-off block: vacation, appointment, closing early.
model TimeOff {
  id       String   @id @default(cuid())
  barberId String
  barber   Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt DateTime // UTC
  endsAt   DateTime // UTC
  reason   String?
  isAllDay Boolean  @default(false)

  @@index([barberId, startsAt, endsAt])
}

model Appointment {
  id String @id @default(cuid())

  barberId String
  barber   Barber @relation(fields: [barberId], references: [id], onDelete: Restrict)

  // A signed-in client, or guest contact details. Exactly one is populated.
  clientId   String?
  client     User?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  guestName  String?
  guestEmail String?
  guestPhone String?

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  startsAt DateTime // UTC
  endsAt   DateTime // UTC — includes the cleanup buffer

  status AppointmentStatus @default(PENDING_PAYMENT)
  source BookingSource     @default(ONLINE)

  /// Snapshot at booking time. Service prices change; history must not.
  priceCents   Int
  depositCents Int

  /// While PENDING_PAYMENT, the slot is held until this instant.
  holdExpiresAt DateTime?

  clientNotes String?
  barberNotes String?

  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?

  /// Unguessable token behind the guest "manage my booking" link.
  manageToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment       Payment?
  notifications Notification[]

  @@index([barberId, startsAt])
  @@index([status, startsAt])
  @@index([startsAt])
}

model Payment {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeRefundId          String?

  amountCents   Int
  refundedCents Int           @default(0)
  status        PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stripe redelivers webhooks; recording event ids makes handling idempotent.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model WaitlistEntry {
  id         String  @id @default(cuid())
  clientId   String?
  client     User?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  guestName  String?
  guestEmail String?

  barberId  String?
  barber    Barber? @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  desiredDate DateTime       @db.Date
  status      WaitlistStatus @default(ACTIVE)
  notifiedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([desiredDate, status])
}

/// Outbox and audit log. A failed send is a visible, retryable row.
model Notification {
  id            String       @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  channel           String // EMAIL | SMS
  type              NotificationType
  status            NotificationStatus @default(QUEUED)
  recipient         String
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())

  @@index([status, createdAt])
}

model GalleryImage {
  id          String  @id @default(cuid())
  url         String
  caption     String?
  barberId    String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)
}

// ── Auth.js adapter models ──────────────────────────────────────────

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
